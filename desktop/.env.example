# Env vars dibaca saat aplikasi desktop dijalankan.
# Untuk development, copy file ini jadi `.env` di folder desktop (loader .env
# sudah ada di config.rs), atau set di system environment sebelum `npm run tauri:dev`:
#   $env:AIRTYPE_SUPABASE_URL="https://example.supabase.co"
#   $env:AIRTYPE_SUPABASE_ANON_KEY="public-anon-key"

AIRTYPE_SUPABASE_URL=https://example.supabase.co
AIRTYPE_SUPABASE_ANON_KEY=public-anon-key
AIRTYPE_PAIRING_BASE_URL=https://airtype.app
AIRTYPE_AUTO_PAUSE_AFTER_MS=60000
AIRTYPE_HISTORY_ENABLED=true
AIRTYPE_HISTORY_LIMIT=100
