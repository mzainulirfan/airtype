{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AirType Helper",
  "version": "0.1.0",
  "identifier": "app.airtype.helper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AirType Helper",
        "width": 480,
        "height": 640,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "airtype-tray",
      "iconPath": "icons/icon.ico",
      "tooltip": "AirType Helper",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
